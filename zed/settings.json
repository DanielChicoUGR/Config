// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 14.0,
  "ui_font_weight": 250.0,
  "buffer_font_weight": 100.0,
  "document_symbols": "on",
  "semantic_tokens": "combined",
  "proxy": "",
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "show_edit_predictions": true,
  "unnecessary_code_fade": 0.5,
  "bottom_dock_layout": "left_aligned",

  "git_panel": {
    "dock": "right",
    "sort_by_path": true,
  },
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "play_sound_when_agent_done": "always",
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.5",
      },
    ],
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini",
    },
    "use_modifier_to_send": true,
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.3-codex",
    },
    "model_parameters": [],
    "inline_alternatives": [
      {
        "provider": "copilot_chat",
        "model": "claude-haiku-4.5",
      },
    ],
    "inline_assistant_use_streaming_tools": true,
  },
  "pane_split_direction_vertical": "right",

  "context_servers": {
    "some-mcp-server": {
      "enabled": true,
      "remote": false,
      "command": "bunx @modelcontextprotocol/server-postgres postgresql://postgres:change-me@localhost:5432/sunergy",
      "args": [],
      "env": {}
    },
    "postgres-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {
        "database_url": "postgresql://postgres:change-me@localhost:5432/sunergy"
      }
    },
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": ""
      }
    },
    "shadcn": {
      "enabled": true,
      "command": "bunx",
      "args": ["--bun", "shadcn@latest", "mcp"],
    },
    "Astro docs": {
      "enabled": true,
      "command": "bunx",
      "args": ["--bun", "mcp-remote", "https://mcp.docs.astro.build/mcp"],
    },
  },
  "ssh_connections": [
    {
      "host": "hmbcentral.live",
      "username": "dachival",
      "args": [],
      "projects": [
        {
          "paths": ["/home/dachival/serverComposes"],
        },
      ],
    },
    {
      "host": "192.168.1.129",
      "username": "dachival",
      "args": [],
      "projects": [
        {
          "paths": ["/home/dachival/foto2video"],
        },
      ],
      "nickname": "HomeServer",
    },
  ],
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Material Icon Theme",
  },
  "jupyter": {
    "enabled": true,
    "kernel_selections": {},
  },
  "file_types": {
    "C": ["c", "h"],
  },
  "allow_rewrap": "anywhere",
  "soft_wrap": "bounded",
  "preferred_line_length": 150,

  "ui_font_size": 15.0,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 14.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "font_family": "Iosevka Nerd Font",
    "font_fallbacks": ["JetBrainsMono Nerd Font Mono"],
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": false,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "off",
  },
  "theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Mocha",
  },

  "languages": {
    "C++": {
      "format_on_save": "on",

      "formatter": "language_server",
      "use_autoclose": true,
      "enable_language_server": true,
      "show_completion_documentation": true,
      "show_wrap_guides": true,
    },
    "C": {
      "format_on_save": "on",
      "tab_size": 1,
      "formatter": "language_server",
      "use_autoclose": true,
      "show_completion_documentation": true,
      "show_wrap_guides": true,
    },
    "Astro": {
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
    },
    "Python": {
      "enable_language_server": true,
      "language_servers": ["ty"],
      "format_on_save": "on",
      "formatter": "auto",
      "inlay_hints": {
        "enabled": true,
        "show_background": true,
      },
      "show_completion_documentation": true,
    },
    "JavaScript": {
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
    },
    "Java": {
      "enable_language_server": true,
      //"formatter": "prettier",
      "show_completion_documentation": true,
    },
    "TypeScript": {
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
    },
    "TSX": {
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
    },

    "Rust": {
      "enable_language_server": true,
      "show_completion_documentation": true,
    },
    "Markdown": {
      "show_edit_predictions": true,
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
    },
    "YAML": {
      "enable_language_server": true,
      "formatter": "prettier",
      "show_completion_documentation": true,
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        // For JavaScript:
        "javascript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": {
              "enabled": true,
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": {
              "enabled": true,
            },
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "enumMemberValues": {
              "enabled": true,
            },
          },
        },
        // For TypeScript:
        "typescript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": {
              "enabled": true,
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": {
              "enabled": true,
            },
            "functionLikeReturnTypes": {
              "enabled": true,
            },
            "enumMemberValues": {
              "enabled": true,
            },
          },
        },
      },
    },
    "texlab": {
      "initialization_options": {
        "build": {
          "onSave": true,
          "executable": "latexmk",
          "args": ["-pdf", "-interaction=nonstopmode", "-synctex=1", "-shell-escape", "-output-directory=build", "TFG.tex"],
          "forwardSearchAfter": false,
        },
        "chktex": {
          "onEdit": true,
          "onOpen": true,
        },
      },
    },
  },

  // "language_servers": ,
  "auto_update": true,

  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },

  "use_autoclose": true,
  "git": {
    "git_gutter": null,
    "gutter_debounce": null,
    "inline_blame": null,
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": false,
  },

  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
    "disabled_globs": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/secrets.yml"],
  },

  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.4-mini"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "haiku",
        "mode": "default",
        "effort": "high"
      },
      "type": "registry",
    },
    "gemini": {
      "default_mode": "default",
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}

